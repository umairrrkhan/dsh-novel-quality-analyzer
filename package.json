{
  "name": "dsh-novel-quality-analyzer",
  "version": "1.1.0",
  "description": "Local, transparent writing-style analysis for DeepSeek Harness: vocabulary, repeated words and sentences, and cliche evidence.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./analysis": "./lib/analyzer.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/REPORT.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-isolation=none",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "npm test && npm run benchmark && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "umairrrkhan",
    "email": "umair64066@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umairrrkhan/dsh-novel-quality-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/umairrrkhan/dsh-novel-quality-analyzer/issues"
  },
  "homepage": "https://github.com/umairrrkhan/dsh-novel-quality-analyzer#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "novel",
    "writing",
    "analysis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
